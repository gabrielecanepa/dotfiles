{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.codex/hooks/guard-committed-writing.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "$HOME/.codex/hooks/guard-managed-files.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.codex/hooks/format-edited-file.sh",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
