{
  "rules": {
    "body-leading-blank": [
      2,
      "always"
    ],
    "scope-case": [
      2,
      "always",
      "lower-case"
    ],
    "scope-enum": [
      2,
      "always",
      [
        "claude",
        "codex",
        "pi",
        "cask",
        "mas",
        "ghostty",
        "vscode",
        "npm",
        "bash",
        "zsh",
        "nvim",
        "vim"
      ]
    ],
    "subject-empty": [
      2,
      "never"
    ],
    "subject-full-stop": [
      2,
      "never",
      "."
    ],
    "type-case": [
      2,
      "always",
      "lower-case"
    ],
    "type-empty": [
      2,
      "never"
    ],
    "type-enum": [
      2,
      "always",
      [
        "agents",
        "brew",
        "chore",
        "docs",
        "git",
        "gui",
        "node",
        "python",
        "ruby",
        "shell",
        "tui"
      ]
    ]
  }
}
