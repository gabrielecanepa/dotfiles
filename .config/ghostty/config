# https://ghostty.org/docs/config

# App
desktop-notifications = true
auto-update = download
auto-update-channel = stable
app-notifications = no-clipboard-copy

# Config
config-default-files = true
working-directory = home
shell-integration = zsh
shell-integration-features = cursor,sudo,no-title
command = /bin/zsh
wait-after-command = false
scrollback-limit = 10000000
link-url = true
image-storage-limit = 320000000
confirm-close-surface = false
quit-after-last-window-closed = false
initial-window = true

# Font
font-family =
font-family-bold =
font-family-italic =
font-family-bold-italic =
font-style = default
font-style-bold = bold
font-style-italic = italic
font-style-bold-italic = bold-italic
font-synthetic-style = true
font-feature =
font-size = 16
font-variation =
font-variation-bold =
font-variation-italic =
font-variation-bold-italic =
font-codepoint-map =
font-thicken = false
font-thicken-strength = 255

# Appearance
theme = light:ghostty-light,dark:ghostty-dark
minimum-contrast = 1
background-opacity = 0.98
background-blur = 5
unfocused-split-opacity = 0.7
adjust-cursor-thickness = 1
cursor-opacity = 0.8
cursor-style = block
cursor-style-blink = true
cursor-click-to-move = true
mouse-hide-while-typing = true
mouse-shift-capture = true
mouse-scroll-multiplier = 1
custom-shader-animation = true

# Window
maximize = true
fullscreen = false
window-subtitle = working-directory
window-title-font-family = Ubuntu Mono
window-inherit-working-directory = true
window-inherit-font-size = true
window-padding-x = 16
window-padding-y = 10
window-padding-balance = true
window-padding-color = background
window-step-resize = false

# Clipboard
clipboard-read = allow
clipboard-write = allow
clipboard-trim-trailing-spaces = true
clipboard-paste-protection = true
clipboard-paste-bracketed-safe = true
copy-on-select = clipboard

# MacOS
macos-titlebar-style = tabs
macos-titlebar-proxy-icon = hidden
macos-window-shadow = true
macos-auto-secure-input = true
macos-secure-input-indication = true
# macos-icon = custom-style
# macos-icon-frame = plastic
# macos-icon-ghost-color = #F9F9F9
# macos-icon-screen-color = #000000
macos-window-buttons = hidden

# Keybindings
keybind = super+alt+left=previous_tab
keybind = super+alt+right=next_tab
keybind = super+ctrl+left=move_tab:-1
keybind = super+ctrl+right=move_tab:1
keybind = super+alt+down=goto_split:next
keybind = super+alt+up=goto_split:previous
keybind = alt+d=new_split:right
keybind = chain=resize_split:right,400
keybind = chain=goto_split:left
keybind = ctrl+alt+left=resize_split:left,10
keybind = ctrl+alt+right=resize_split:right,10
keybind = ctrl+alt+up=resize_split:up,10
keybind = ctrl+alt+down=resize_split:down,10
