root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 100

[[shell]]
switch_case_indent = true

[[bash]]
switch_case_indent = true

[{.zshenv,.zprofile,.zshrc}]
shell_variant = zsh
switch_case_indent = true

[.zsh/{plugins,themes}/**]
ignore = true
