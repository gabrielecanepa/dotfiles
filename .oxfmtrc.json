{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/HEAD/npm/oxfmt/configuration_schema.json",
  "ignorePatterns": [
    ".agents/**/*.html",
    "**/*-lock.json"
  ],
  "overrides": [
    {
      "files": [
        "*.cjs",
        "*.cts",
        "*.js",
        "*.jsx",
        "*.mjs",
        "*.mts",
        "*.ts",
        "*.tsx"
      ],
      "excludeFiles": [
        ".zsh/**"
      ],
      "options": {
        "arrowParens": "avoid",
        "semi": false,
        "singleQuote": true,
        "trailingComma": "es5"
      }
    },
    {
      "files": [
        "*.json",
        "*.jsonc"
      ],
      "options": {
        "printWidth": 1,
        "trailingComma": "none"
      }
    },
    {
      "files": [
        "**/.agents/**/*.md"
      ],
      "options": {
        "embeddedLanguageFormatting": "off"
      }
    }
  ]
}
