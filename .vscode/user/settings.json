  },
  "knip.requireConfig": true,
  "less.lint.duplicateProperties": "warning",
  "markdown.extension.toc.levels": "2..6",
  "markdown.preview.doubleClickToSwitchToEditor": false,
  "merge-conflict.autoNavigateNextConflict.enabled": true,
  "merge-conflict.codeLens.enabled": false,
  "oxc.fixKind": "safe_fix_or_suggestion",
  "oxc.unusedDisableDirectives": "deny",
  "scm.diffDecorations": "gutter",
  "scss.format.newlineBetweenSelectors": false,
  "scss.format.spaceAroundSelectorSeparator": true,
  "scss.lint.compatibleVendorPrefixes": "warning",
  "scss.lint.duplicateProperties": "warning",
  "scss.lint.float": "warning",
