{
  "[shellscript]": {
    "editor.defaultFormatter": "mkhl.shfmt"
  },
  "application.shellEnvironmentResolutionTimeout": 20,
  "biome.requireConfiguration": true,
  "biome.suggestInstallingGlobally": false,
  "chat.agent.maxRequests": 500,
  "chat.agent.thinking.collapsedTools": "withThinking",
  "chat.agent.thinkingStyle": "collapsed",
  "chat.checkpoints.showFileChanges": true,
  "chat.defaultModel": "opus",
  "chat.editing.confirmEditRequestRemoval": false,
  "chat.editing.confirmEditRequestRetry": false,
  "chat.instructionsFilesLocations": {
    ".claude/rules": false,
    "~/.claude/rules": false
  },
  "chat.mcp.discovery.enabled": {
    "claude-desktop": true
  },
  "chat.mcp.gallery.enabled": true,
  "chat.permissions.default": "autoApprove",
  "chat.sessionSync.enabled": true,
  "chat.titleBar.openInAgentsWindow.enabled": false,
  "chat.tools.urls.autoApprove": {
    "https://*.claude.com": true,
    "https://*.drizzle.team": true,
    "https://*.npmjs.com": true,
    "https://agentskills.io": true,
    "https://azure.microsoft.com": true,
    "https://better-auth.com": true,
    "https://biomejs.dev": true,
    "https://context7.com": true,
    "https://github.com": true,
    "https://learn.microsoft.com": true,
    "https://neon.com": true,
    "https://next-intl.dev": true,
    "https://nuqs.47ng.com": true,
    "https://nuqs.dev": true,
    "https://oxc.rs": true,
    "https://shopify.dev": true,
    "https://skills.sh": true,
    "https://tiptap.dev": true,
    "https://ui.shadcn.com": true
  },
  "chat.useAgentSkills": true,
  "chat.useClaudeHooks": true,
  "chat.useNestedAgentsMdFiles": true,
  "chat.viewSessions.orientation": "stacked",
  "css.format.newlineBetweenRules": false,
  "css.format.newlineBetweenSelectors": false,
  "css.format.spaceAroundSelectorSeparator": true,
  "css.lint.duplicateProperties": "warning",
  "diffEditor.ignoreTrimWhitespace": false,
  "diffEditor.renderSideBySide": false,
  "editor.accessibilitySupport": "off",
  "editor.bracketPairColorization.independentColorPoolPerBracketType": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.shellcheck": "explicit"
  },
  "editor.colorDecorators": true,
  "editor.definitionLinkOpensInPeek": false,
  "editor.fontSize": 13,
  "editor.formatOnSave": true,
  "editor.gotoLocation.alternativeDefinitionCommand": "",
  "editor.gotoLocation.multipleDeclarations": "goto",
  "editor.gotoLocation.multipleDefinitions": "goto",
  "editor.gotoLocation.multipleImplementations": "goto",
  "editor.gotoLocation.multipleTypeDefinitions": "goto",
  "editor.guides.bracketPairsHorizontal": "active",
  "editor.guides.highlightActiveIndentation": "always",
  "editor.inlineSuggest.enabled": true,
  "editor.lightbulb.enabled": "off",
  "editor.maxTokenizationLineLength": 200000,
  "editor.minimap.enabled": false,
  "editor.quickSuggestions": {
    "comments": "on",
    "other": "on"
  },
  "editor.suggestSelection": "first",
  "editor.tabSize": 2,
  "editor.tokenColorCustomizations": {
    "[*Dark*]": {
      "textMateRules": [
        {
          "scope": "ref.matchtext",
          "settings": {
            "foreground": "#fff"
          }
        }
      ]
    },
    "[*Light*]": {
      "textMateRules": [
        {
          "scope": "ref.matchtext",
          "settings": {
            "foreground": "#000"
          }
        }
      ]
    },
    "textMateRules": []
  },
  "editor.unicodeHighlight.allowedCharacters": {
    "–": true,
    "›": true
  },
  "emmet.includeLanguages": {
    "blade": "html",
    "erb": "html",
    "javascript": "javascriptreact",
    "markdown": "markdown",
    "typescript": "typescriptreact",
    "vue": "html"
  },
  "emmet.showExpandedAbbreviation": "inMarkupAndStylesheetFilesOnly",
  "emmet.syntaxProfiles": {
    "javascript": "jsx"
  },
  "emmet.triggerExpansionOnTab": true,
  "explorer.autoOpenDroppedFile": false,
  "explorer.autoRevealExclude": {
    "**/.git": true,
    "**/.private": true,
    "**/node_modules": true,
    "**/private": true,
    "**/tmp": true
  },
  "explorer.compactFolders": false,
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.confirmPasteNative": false,
  "explorer.confirmUndo": "light",
  "extensions.allowOpenInModalEditor": true,
  "files.associations": {
    ".env*": "properties",
    "*.json.lock": "jsonl",
    "*.todo": "markdown",
    "**/com.mitchellh.ghostty/config": "ghostty",
    "**/com.mitchellh.ghostty/themes/*": "ghostty",
    "**/ghostty/config": "ghostty",
    "**/ghostty/themes/*": "ghostty",
    "applypatch-msg": "shellscript",
    "commit-msg": "shellscript",
    "fsmonitor-watchman": "shellscript",
    "ignore": "ignore",
    "NOTES": "markdown",
    "p4-changelist": "shellscript",
    "p4-post-changelist": "shellscript",
    "p4-pre-submit": "shellscript",
    "p4-prepare-changelist": "shellscript",
    "post-applypatch": "shellscript",
    "post-checkout": "shellscript",
    "post-commit": "shellscript",
    "post-index-change": "shellscript",
    "post-merge": "shellscript",
    "post-receive": "shellscript",
    "post-rewrite": "shellscript",
    "post-update": "shellscript",
    "pre-applypatch": "shellscript",
    "pre-auto-gc": "shellscript",
    "pre-commit": "shellscript",
    "pre-merge-commit": "shellscript",
    "pre-push": "shellscript",
    "pre-rebase": "shellscript",
    "pre-receive": "shellscript",
    "prepare-commit-msg": "shellscript",
    "proc-receive": "shellscript",
    "push-to-checkout": "shellscript",
    "reference-transaction": "shellscript",
    "sendemail-validate": "shellscript",
    "TODO": "markdown"
  },
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 1000,
  "files.exclude": {
    "**/.git": false
  },
  "files.insertFinalNewline": true,
  "files.watcherExclude": {
    "**/.bun/**": true,
    "**/.cache/**": true,
    "**/.gem/**": true,
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/.local/share/**": true,
    "**/.local/state/**": true,
    "**/.next/**": true,
    "**/.nodenv/**": true,
    "**/.npm/**": true,
    "**/.pnpm-store/**": true,
    "**/.pnpm/**": true,
    "**/.pyenv/**": true,
    "**/.rbenv/**": true,
    "**/.Trash/**": true,
    "**/.vscode-server/**": true,
    "**/dist/**": true,
    "**/Library/**": true,
    "**/node_modules/**": true
  },
  "git.addAICoAuthor": "off",
  "git.allowForcePush": true,
  "git.autofetch": true,
  "git.autofetchPeriod": 60,
  "git.autoRepositoryDetection": "openEditors",
  "git.autoStash": true,
  "git.blame.editorDecoration.enabled": true,
  "git.closeDiffOnOperation": true,
  "git.confirmForcePush": false,
  "git.confirmSync": false,
  "git.detectSubmodules": false,
  "git.enableSmartCommit": true,
  "git.fetchOnPull": true,
  "git.ignoreLegacyWarning": true,
  "git.ignoreMissingGitWarning": true,
  "git.inputValidationSubjectLength": 60,
  "git.openRepositoryInParentFolders": "never",
  "git.pruneOnFetch": true,
  "git.pullBeforeCheckout": true,
  "git.rebaseWhenSync": true,
  "git.repositoryScanIgnoredFolders": [
    ".bun",
    ".cache",
    ".pnpm-store",
    ".pnpm",
    ".vscode-server",
    "node_modules"
  ],
  "git.scanRepositories": [],
  "git.useEditorAsCommitInput": false,
  "github.copilot.chat.agent.autoFix": true,
  "github.copilot.chat.anthropic.tools.websearch.enabled": true,
  "github.copilot.chat.claudeAgent.allowAutoPermissions": true,
  "github.copilot.chat.cloudAgentBackend.version": "v2",
  "github.copilot.chat.codesearch.enabled": true,
  "github.copilot.chat.commitMessageGeneration.instructions": [
    {
      "text": "Generate a single-line conventional commit message in the format `<type>: <description>`. Rules: use imperative mood, sentence case, no period at the end. Never include a scope. Never include a body or footer unless the change is a breaking change, which adds a `BREAKING CHANGE:` footer. Never include `Co-authored-by` or any other trailer. Keep the description concise (under 50 characters when possible). Allowed types: feat, fix, refactor, chore, docs, style, test, perf, ci, build, revert. Examples: `feat: Add date range filter to search`, `fix: Prevent duplicate API calls on mount`, `refactor: Simplify auth token refresh logic`, `chore: Update dependencies`."
    }
  ],
  "github.copilot.chat.githubMcpServer.enabled": true,
  "github.copilot.chat.languageContext.fix.typescript.enabled": true,
  "github.copilot.chat.languageContext.inline.typescript.enabled": true,
  "github.copilot.chat.languageContext.typescript.enabled": true,
  "github.copilot.chat.newWorkspace.useContext7": true,
  "github.copilot.chat.responsesApiContextManagement.enabled": true,
  "github.copilot.chat.switchAgent.enabled": true,
  "github.copilot.chat.updated53CodexPrompt.enabled": false,
  "github.copilot.enable": {
    "*": true,
    "markdown": true,
    "plaintext": true,
    "scminput": false
  },
  "github.copilot.nextEditSuggestions.enabled": false,
  "githubPullRequests.pullBranch": "never",
  "html.autoCreateQuotes": true,
  "html.format.indentInnerHtml": true,
  "html.format.templating": true,
  "html.format.unformatted": "html,style",
  "i18n-ally.translate.openai.apiModel": "gpt-4-32k-0613",
  "inlineChat.defaultModel": "Auto (copilot)",
  "js/ts.experimental.useTsgo": true,
  "js/ts.preferences.importModuleSpecifier": "non-relative",
  "js/ts.preferences.importModuleSpecifierEnding": "minimal",
  "js/ts.preferences.includePackageJsonAutoImports": "on",
  "js/ts.updateImportsOnFileMove.enabled": "always",
  "json.schemaDownload.enable": true,
  "json.schemaDownload.trustedDomains": {
    "https://*.vercel.sh/": true,
    "https://biomejs.dev/": true,
    "https://developer.microsoft.com/json-schemas/": true,
    "https://json-schema.org/": true,
    "https://json.schemastore.org/": true,
    "https://raw.githubusercontent.com/": true,
    "https://schemastore.azurewebsites.net/": true,
