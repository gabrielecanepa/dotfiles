{
  "[instructions]": {
    "editor.formatOnSave": false
  },
  "chat.instructionsFilesLocations": {
    ".agents/rules": true,
    ".claude/rules": false,
    ".github/instructions": false,
    "~/.claude/rules": false,
    "~/.copilot/instructions": false
  },
  "chat.useAgentsMdFile": false,
  "chat.useClaudeMdFile": false,
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "explorer.autoRevealExclude": {
    "**/.vault": true,
    "**/bower_components": true,
    "**/node_modules": true
  },
  "files.associations": {
    ".aliases": "shellscript",
    "**/.config/git/config": "properties"
  },
  "files.exclude": {
    ".CFUserTextEncoding": true,
    ".hushlogin": true,
    "**/.DS_Store": true,
    "**/.trash": true,
    "**/.Trash": true,
    "**/*_history": true,
    "Applications": true,
    "Desktop": true,
    "Developer": true,
    "Documents": true,
    "Downloads": true,
    "Library": true,
    "Movies": true,
    "Music": true,
    "OrbStack": true,
    "Pictures": true,
    "Public": true
  },
  "git.autoRepositoryDetection": "subFolders",
  "git.ignoredRepositories": [
    ".oh-my-zsh"
  ],
  "git.scanRepositories": [
    ".vault"
  ],
  "github.copilot.chat.commitMessageGeneration.instructions": [
    {
      "text": "Generate a single-line conventional commit message in the format `<type>(<scope>): <subject>`. Use the imperative mood, keep the subject lower-case with no trailing period, and omit the scope when no listed scope fits. Allowed types: agents, brew, chore, docs, git, gui, node, python, ruby, shell. Allowed scopes: bash, cask, claude, codex, copilot, ghostty, mas, npm, sh, vscode, zed, zsh. Never use feat, fix, or refactor. Never add a body, footer, `Co-authored-by`, or any other trailer."
    }
  ],
  "markdown.extension.toc.levels": "3..6",
  "oxc.enable.oxfmt": true,
  "oxc.fmt.configPath": ".oxfmtrc.json",
  "search.exclude": {
    "**/.claude/rules": true,
    "**/.claude/skills": true,
    "**/.codex/AGENTS.md": true,
    "**/.codex/hooks.json": true,
    "**/.codex/skills": true,
    "**/.copilot/copilot-instructions.md": true,
    "**/.copilot/instructions": true,
    "**/*.code-search": true,
    "**/bower_components": true,
    "**/node_modules": true
  },
  "shellcheck.ignorePatterns": {
    ".aliases": true
  }
}
