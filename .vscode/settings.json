{
  "chat.useAgentsMdFile": false,
  "chat.useClaudeMdFile": false,
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.formatOnSave": true,
  "files.associations": {
    "aliases.zsh": "shellscript",
    ".config/gem/gemrc": "yaml",
    ".config/git/config": "properties",
    ".zshrc.local": "shellscript"
  },
  "files.exclude": {
    ".CFUserTextEncoding": true,
    ".vscode-*": true,
    ".zsh_sessions": true,
    "*_history": true,
    "**/.localized": true
  },
  "files.watcherExclude": {
    "Developer/**": true
  },
  "git.ignoredRepositories": [
    ".oh-my-zsh"
  ],
  "github.copilot.chat.commitMessageGeneration.instructions": [
    {
      "text": "Generate a single-line conventional commit message in the format `<type>(<scope>): <subject>`. Use an imperative mood, lower-case subject with no trailing period, and omit the scope when none fits. Allowed types and scopes are listed in ~/.commitlintrc.json; never use different ones. Never add a body, footer, `Co-authored-by`, or other trailers."
    }
  ],
  "markdown.extension.toc.levels": "3..6",
  "oxc.enable.oxfmt": true,
  "search.exclude": {
    "**/.claude/CLAUDE.md": true,
    "**/.claude/rules": true,
    "**/.claude/skills": true,
    "**/.codex/AGENTS.md": true,
    "**/.codex/hooks.json": true,
    "**/.codex/skills": true,
    "**/.copilot/copilot-instructions.md": true,
    "**/*.code-search": true,
    "**/bower_components": true,
    "**/node_modules": true
  },
  "shellcheck.ignorePatterns": {
    ".zsh/aliases.zsh": true,
    ".zsh/plugins/*/_*": true,
    ".zsh/themes/*": true,
    ".zshrc.local": true
  }
}
