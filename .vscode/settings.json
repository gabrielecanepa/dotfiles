{
  "[instructions]": {
    "editor.formatOnSave": false
  },
  "chat.instructionsFilesLocations": {
    ".claude/rules": false,
    ".github/instructions": true,
    "~/.claude/rules": false,
    "~/.copilot/instructions": false
  },
  "chat.useAgentsMdFile": false,
  "chat.useClaudeMdFile": false,
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "files.associations": {
    ".aliases": "shellscript",
    ".commitlintrc": "json",
    "*.json.lock": "jsonl"
  },
  "files.exclude": {
    ".DS_Store": true,
    ".Trash": true,
    "*_history": true,
    "Applications": true,
    "Claude": true,
    "Desktop": true,
    "Developer": true,
    "Documents": true,
    "Downloads": true,
    "Library": true,
    "Movies": true,
    "Music": true,
    "Pictures": true,
    "Public": true
  },
  "git.autoRepositoryDetection": false,
  "git.ignoredRepositories": [
    ".oh-my-zsh"
  ],
  "markdown.extension.toc.levels": "3..6",
  "oxc.enable.oxfmt": true,
  "oxc.fmt.configPath": ".oxfmtrc.json",
  "search.exclude": {
    "**/.claude": true,
    "**/.codex": true,
    "**/*.code-search": true,
    "**/bower_components": true,
    "**/node_modules": true
  }
}
