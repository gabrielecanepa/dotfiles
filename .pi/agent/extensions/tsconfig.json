{
  "include": [
    "**/*.ts",
    "**/*.mts"
  ],
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "lib": [
      "es2023",
      "dom"
    ],
    "module": "preserve",
    "moduleResolution": "bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2023",
    "types": [
      "node"
    ],
    "verbatimModuleSyntax": true
  }
}
