{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "fable",
  "fallbackModel": ["opus", "default"],
  "effortLevel": "high",
  "alwaysThinkingEnabled": false,
  "showThinkingSummaries": false,
  "outputStyle": "Concise",
  "includeGitInstructions": false,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "skipAutoPermissionPrompt": true,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "statusLine": {
    "type": "command",
    "command": "$HOME/.agents/statusline.sh",
    "padding": 0,
    "refreshInterval": 10
  },
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "remoteControlAtStartup": true,
  "autoCompactEnabled": true,
  "plansDirectory": ".agents/plans",
  "cleanupPeriodDays": 60,
  "worktree": {
    "baseRef": "fresh",
    "symlinkDirectories": ["node_modules"]
  },
  "sandbox": {
    "enabled": true,
    "network": {
      "allowedDomains": ["registry.npmjs.org", "github.com", "*.github.com", "*.githubusercontent.com"],
      "allowUnixSockets": ["~/Library/Group Containers/*.com.1password/t/agent.sock"]
    }
  },
  "autoAllowBashIfSandboxed": true,
  "permissions": {
    "defaultMode": "auto",
    "ask": ["Bash(git commit:*)", "Bash(git push:*)", "Read(**/.env)", "Read(**/.env.*)"],
    "deny": ["Write(**/.env)", "Write(**/.env.*)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/guard-managed-files.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/format-edited-file.sh",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "vercel@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "hookify@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  }
}
