{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 180,
  "env": {
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "3",
    "CLAUDE_CODE_MAX_SUBAGENTS_PER_SESSION": "12",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "includeGitInstructions": false,
  "permissions": {
    "deny": [
      "Bash(rm -rf:*)",
      "Read(//**/.env)",
      "Read(//**/.env.*)",
      "Read(//**/*.key)",
      "Read(//**/*.p12)",
      "Read(//**/*.pem)",
      "Read(//**/*.pfx)",
      "Read(//**/id_ed25519)",
      "Read(//**/id_rsa)",
      "Read(//**/secrets/**)",
      "Read(~/.aws/**)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.ssh/id_*)",
      "Read(~/Library/Group Containers/*.com.1password/**)",
      "Read(~/Library/Keychains/**)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)"
    ],
    "defaultMode": "auto"
  },
  "fallbackModel": [
    "default"
  ],
  "enabledMcpjsonServers": [
    "cloudflare",
    "shadcn",
    "vercel"
  ],
  "skillOverrides": {
    "review-animations": "user-invocable-only",
    "vercel-react-view-transitions": "user-invocable-only"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.agents/hooks/guard-committed-writing.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "$HOME/.agents/hooks/guard-managed-files.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.agents/hooks/guard-remote-execution.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.agents/hooks/format-edited-file.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.agents/hooks/autoname-session.sh",
            "timeout": 20
          }
        ]
      }
    ]
  },
  "worktree": {
    "symlinkDirectories": [
      "node_modules"
    ],
    "baseRef": "fresh",
    "bgIsolation": "none"
  },
  "workflowSizeGuideline": "small",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "refreshInterval": 5
  },
  "subagentStatusLine": {
    "type": "command",
    "command": "~/.claude/subagent-statusline.sh"
  },
  "enabledPlugins": {
    "claude-security@claude-plugins-official": false,
    "security-guidance@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "outputStyle": "Concise",
  "sandbox": {
    "enabled": false,
    "network": {
      "allowedDomains": [
        "registry.npmjs.org",
        "github.com",
        "*.github.com",
        "*.githubusercontent.com"
      ],
      "allowUnixSockets": [
        "~/Library/Group Containers/*.com.1password/t/agent.sock"
      ]
    }
  },
  "feedbackSurveyRate": 0,
  "feedbackDrafts": "notify",
  "spinnerTipsEnabled": false,
  "spinnerVerbs": {
    "mode": "append",
    "verbs": [
      "Squanching",
      "Claudiando",
      "Personally asking Dario Amodei",
      "Asking GPT"
    ]
  },
  "askUserQuestionTimeout": "never",
  "plansDirectory": ".agents/plans",
  "tui": "fullscreen",
  "showThinkingSummaries": false,
  "skipDangerousModePermissionPrompt": true,
  "theme": "auto",
  "editorMode": "normal",
  "verbose": false,
  "preferredNotifChannel": "auto",
  "autoCompactEnabled": true,
  "switchModelsOnFlag": true,
  "autoContinueAtUsageLimit": true,
  "autoScrollEnabled": true,
  "fileCheckpointingEnabled": true,
  "showTurnDuration": true,
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "autoAllowBashIfSandboxed": true
}
