#compdef code-workspace

# Completion for the `code-workspace` command: workspace names under $VSCODE_WORKSPACES_PATH.

_code-workspace() {
  local dir="${VSCODE_WORKSPACES_PATH:-$HOME/.vscode/workspaces}"
  # -U keeps names deduplicated.
  local -aU names
  # (.N:t:r): plain files only (.), null glob when none match (N), basename (:t), strip .code-workspace (:r).
  names=("$dir"/*.code-workspace(.N:t:r))
  _describe -t workspaces 'workspace' names
}

_code-workspace "$@"
