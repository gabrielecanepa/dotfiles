#compdef ccarchive
#
# Completions for ccarchive: subcommands, per-subcommand flags, and ids described by session name.

_ccarchive_pairs() {
  (( $# )) || return 1
  jq -r '(input_filename | split("/")[-2]) + ":" + (.name // "unnamed") + " · " + (.state // "?")' \
    -- "$@" 2>/dev/null
}

_ccarchive_archives() {
  local root="${CCARCHIVE_ROOT:-${XDG_DATA_HOME:-$HOME/.local/share}/claude/archive}"
  local -a ids=(${(f)"$(_ccarchive_pairs "$root"/*/manifest.json(N))"})
  (( $#ids )) || return 1
  _describe -t archives archive ids
}

_ccarchive_cards() {
  local jobs="${CCARCHIVE_JOBS:-$HOME/.claude/jobs}"
  local -a ids=(${(f)"$(_ccarchive_pairs "$jobs"/*/state.json(N))"})
  (( $#ids )) || return 1
  _describe -t cards card ids
}

_ccarchive() {
  local curcontext=$curcontext state line ret=1
  local -a commands=(
    'list:list archives, newest first'
    'save:archive one live fleet card'
    'sweep:archive every card that changed since its last sweep'
    'restore:put an archived card back in fleet view'
    'show:print an archived conversation'
    'search:report archives whose transcript matches'
    'rm:remove archives'
    'prune:remove archives older than an age'
    'help:show usage'
  )

  _arguments -C \
    '(- *)'{-h,--help}'[show usage]' \
    '1: :->command' \
    '*:: :->args' && ret=0

  case $state in
    command)
      _describe -t commands 'ccarchive command' commands && ret=0
      ;;
    args)
      case $words[1] in
        list | ls)
          _arguments \
            '--cwd[only archives under a directory]:directory:_files -/' \
            '--state[only archives in one state]:state:(done stopped working running)' \
            '--orphaned[only archives whose original transcript is gone]' && ret=0
          ;;
        save)
          _arguments \
            '--with-tmp[also copy the card scratch directory]' \
            '*:card:_ccarchive_cards' && ret=0
          ;;
        sweep)
          _arguments \
            '(-q --quiet)'{-q,--quiet}'[stay silent when nothing changed]' \
            '(-f --force)'{-f,--force}'[re-archive every card]' \
            '(-n --dry-run)'{-n,--dry-run}'[report what would be archived]' && ret=0
          ;;
        restore)
          _arguments \
            '(-f --force)'{-f,--force}'[overwrite an existing card]' \
            '1:archive:_ccarchive_archives' && ret=0
          ;;
        show)
          _arguments \
            '(--full --json --html)--full[include tool calls]' \
            '(--full --json --html)--json[print the raw jsonl]' \
            '(--full --json --html)--html[render with claude-code-log]' \
            '1:archive:_ccarchive_archives' && ret=0
          ;;
        search)
          _message 'search pattern' && ret=0
          ;;
        rm)
          _arguments \
            '(-y --yes)'{-y,--yes}'[skip the confirmation]' \
            '*:archive:_ccarchive_archives' && ret=0
          ;;
        prune)
          _arguments \
            '--older-than[age cutoff]:age:(7d 30d 90d 6m 1y 2y)' \
            '(-n --dry-run)'{-n,--dry-run}'[report what would be removed]' \
            '(-y --yes)'{-y,--yes}'[skip the confirmation]' && ret=0
          ;;
      esac
      ;;
  esac

  return ret
}

_ccarchive "$@"
